include "../sha256_impl.saw";

verify_symbol rust__sha2__sha256_stream__hash "sha256_stream::hash at 56 bytes (against the reversed message)"
  [compress]
  (hash_contract 56 {{ \(msg : [56][8]) -> split (hash (join (reverse msg))) : [32][8] }})
