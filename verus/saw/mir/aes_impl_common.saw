/*
 * What the AES implementation's MIR SAW scripts share: the crate's MIR,
 * NSA's Cryptol, and the contracts, one per shape of Rust function, as
 * algorithms/AES/rust/Cipher/theorems/saw.py has them (block_to_block,
 * round, cipher), in SAWScript rather than the Python client.
 *
 * Run from verus/saw/mir/ by verus/scripts/check-saw.sh, which first
 * compiles the crate with mir-json (cargo saw-build) to
 * ../obj/mir/foundation_verus.linked-mir.json. Not run by CI: see
 * verus/doc/saw.md.
 */

enable_experimental;

import "../../../algorithms/AES/GF28.cry";
import "../../../algorithms/AES/SBox.cry";
import "../../../algorithms/AES/Cipher.cry";
import "../../../algorithms/AES/KeyExpansion.cry";
import "../../../algorithms/AES/Main.cry";

/*
 * The crate's MIR, with its dependencies' and the standard library's
 * (SAW_RUST_LIBRARY_PATH), linked by mir-json into one file.
 */
crate <- mir_load_module "../obj/mir/foundation_verus.linked-mir.json";

/*
 * A function of the crate by its Rust path; a const generic instance
 * (expand_key::<128>) by mir_find_name with the constant, since mir-json
 * names each instance by a hash.
 */
let rust (path : String) = str_concat "foundation_verus::" path;
let rust_k (path : String) (k : Term) =
  mir_find_name crate (rust path) [mir_const mir_u32 k];

/*
 * The MIR types of the Rust ones: u8, AESWord = [u8; 4], Block = [u8; 16]
 * are Cryptol's [8], [4][8] and [16][8] as they are.
 */
let byte_t = mir_u8;
let word_t = mir_array 4 byte_t;
let block_t = mir_array 16 byte_t;

let byte_to_byte_contract (f : Term) = do {
  b <- mir_fresh_var "b" byte_t;
  mir_execute_func [mir_term b];
  mir_return (mir_term {{ f b }});
};
let byte_byte_to_byte_contract (f : Term) = do {
  b <- mir_fresh_var "b" byte_t;
  c <- mir_fresh_var "c" byte_t;
  mir_execute_func [mir_term b, mir_term c];
  mir_return (mir_term {{ f b c }});
};
let word_to_word_contract (f : Term) = do {
  a <- mir_fresh_var "a" word_t;
  mir_execute_func [mir_term a];
  mir_return (mir_term {{ f a }});
};
let word_word_to_word_contract (f : Term) = do {
  a <- mir_fresh_var "a" word_t;
  b <- mir_fresh_var "b" word_t;
  mir_execute_func [mir_term a, mir_term b];
  mir_return (mir_term {{ f a b }});
};

/*
 * fn f(state: &mut Block): a mutable reference, written in place.
 */
let block_in_place_contract (f : Term) = do {
  state <- mir_fresh_var "state" block_t;
  p <- mir_alloc_mut block_t;
  mir_points_to p (mir_term state);
  mir_execute_func [p];
  mir_points_to p (mir_term {{ f state }});
};

/*
 * fn f(state: &mut Block, key: &Block).
 */
let block_key_contract (f : Term) = do {
  state <- mir_fresh_var "state" block_t;
  p <- mir_alloc_mut block_t;
  mir_points_to p (mir_term state);
  key <- mir_fresh_var "key" block_t;
  kp <- mir_alloc block_t;
  mir_points_to kp (mir_term key);
  mir_execute_func [p, kp];
  mir_points_to p (mir_term {{ f state key }});
};

/*
 * fn encrypt_block::<k>(w: &[Block], state: &mut Block), and the two
 * decryptions: w a slice of len blocks, of which the first Nr k + 1 are
 * the round keys (the Rust's round_keys), as the template's
 * cipher_Contract (ref_to_fresh, then slice_value).
 */
let cipher_contract (nr : Int) (len : Int) (f : Term) = do {
  w <- mir_fresh_var "w" (mir_array len block_t);
  wp <- mir_alloc (mir_array len block_t);
  mir_points_to wp (mir_term w);
  state <- mir_fresh_var "state" block_t;
  p <- mir_alloc_mut block_t;
  mir_points_to p (mir_term state);
  mir_execute_func [mir_slice_value wp, p];
  mir_points_to p (mir_term {{ f (take`{nr + 1} w) state }});
};

/*
 * fn expand_key::<k>(key: &[AESWord]) -> [Block; 15]: the first Nr k + 1
 * blocks are KeyExpansion`{k} of the first Nk k words, the rest zero.
 */
let expand_key_contract (nk : Int) (nr : Int) (len : Int) (f : Term) = do {
  key <- mir_fresh_var "key" (mir_array len word_t);
  keyp <- mir_alloc (mir_array len word_t);
  mir_points_to keyp (mir_term key);
  mir_execute_func [mir_slice_value keyp];
  mir_return (mir_term {{ f (take`{nk} key) # (zero : [14 - nr][16][8]) }});
};

/*
 * fn encrypt::<k>(key: &[u8], input: Block) -> Block, and decrypt: on the
 * bits, as Main.cry's AES`{k}.Encrypt and .Decrypt take them.
 */
let main_contract (nbytes : Int) (f : Term) = do {
  key <- mir_fresh_var "key" (mir_array nbytes byte_t);
  keyp <- mir_alloc (mir_array nbytes byte_t);
  mir_points_to keyp (mir_term key);
  input <- mir_fresh_var "input" block_t;
  mir_execute_func [mir_slice_value keyp, mir_term input];
  mir_return (mir_term {{ split (f (join key) (join input)) : [16][8] }});
};

/*
 * mir_verify of one function against a Cryptol term, timed, with the
 * line check-saw.sh records (as ../llvm/aes_impl_common.saw's).
 */
let verify_symbol symbol name overrides contract tactic tactic_name cryptol = do {
  result <- time (mir_verify crate symbol overrides false contract tactic);
  print (str_concat (str_concat (str_concat (str_concat (str_concat "RESULT proved " name) " = ") cryptol) " [") (str_concat tactic_name "]"));
  return result;
};
let verify_rme symbol name overrides contract cryptol =
  verify_symbol symbol name overrides contract rme "rme" cryptol;
