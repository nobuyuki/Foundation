/*
 * algorithms::SHA2::Main at SHA-256's parameters, as a named module, for
 * the SAW scripts of verus/saw/: the parameters are copied from
 * algorithms/SHA2/SHA256.cry (SHA256.cry:19-30), which instantiates Main
 * the same way but privately (`import algorithms::SHA2::Main as SHA256
 * where ...`), so that its `step` cannot be named from outside. This
 * module exports the instance's `step` and `hash` as `step` and `hash`.
 *
 * Two things stand between the scripts and SHA256.cry itself: the
 * private instance, and SAW 1.6, which cannot load SHA256.cry at all
 * (it is packaging::Hash instantiated, Hash.cry imports
 * algorithms/PBKDF/Main.cry, and SAW's translation of that module fails).
 * NSA's Cryptol is not modified: this file only instantiates it, as
 * verus/cryptol/Verus/SHA2/SHA256.cry's Main256 does for the FFI check
 * and SPARK's spark/saw/SHA256Main.cry does for its SAW proofs.
 */
module SHA256Main = algorithms::SHA2::Main where

import algorithms::SHA2::Preprocessing (H0_256)
import algorithms::SHA2::Functions ( SIGMA_256_0
                                   , SIGMA_256_1
                                   , sigma_256_0
                                   , sigma_256_1
                                   , K_256)

type d = 256
type w = 32
type Klen = 64

H0 = H0_256
K = K_256

SIGMA_0 = SIGMA_256_0
SIGMA_1 = SIGMA_256_1
sigma_0 = sigma_256_0
sigma_1 = sigma_256_1
